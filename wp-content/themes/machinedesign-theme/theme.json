{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "860px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "custom": true,
      "link": true,
      "palette": [
        { "slug": "carbon-base", "color": "#0B0D11", "name": "کربن آنودایز (پس‌زمینه اصلی)" },
        { "slug": "slate-surface", "color": "#12161E", "name": "اسلیت ماشین‌کاری (سطح کارت)" },
        { "slug": "titanium-surface", "color": "#1A202B", "name": "تیتانیوم برس‌خورده (سطح برجسته)" },
        { "slug": "hairline-border", "color": "#262E3D", "name": "خط مهندسی (مرز دقیق)" },
        { "slug": "signal-amber", "color": "#D97706", "name": "کهربایی صنعتی (CTA اصلی)" },
        { "slug": "amber-hover", "color": "#F59E0B", "name": "کهربایی روشن (هاور)" },
        { "slug": "cad-steel", "color": "#38BDF8", "name": "آبی فولادی CAD (شاخص فنی)" },
        { "slug": "titanium-white", "color": "#F3F5F8", "name": "سفید تیتانیوم (متن اصلی)" },
        { "slug": "machined-silver", "color": "#9BA7B8", "name": "نقره‌ای مات (متن ثانویه)" },
        { "slug": "technical-muted", "color": "#64748B", "name": "خاکستری فنی (توضیحات)" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "customFontSize": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Vazirmatn\", \"IRANSansX\", Tahoma, system-ui, -apple-system, sans-serif",
          "name": "Vazirmatn (فارسی استاندارد)",
          "slug": "vazirmatn"
        },
        {
          "fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
          "name": "JetBrains Mono (اعداد و استانداردهای فنی)",
          "slug": "mono"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "size": "0.75rem", "name": "XS (12px)" },
        { "slug": "sm", "size": "0.875rem", "name": "SM (14px)" },
        { "slug": "base", "size": "1rem", "name": "Base (16px)" },
        { "slug": "lg", "size": "1.125rem", "name": "LG (18px)" },
        { "slug": "xl", "size": "1.375rem", "name": "XL (22px)" },
        { "slug": "2xl", "size": "clamp(1.65rem, 2.5vw, 2.25rem)", "name": "2XL (تیتر بخش)" },
        { "slug": "hero", "size": "clamp(2.1rem, 4vw, 3.35rem)", "name": "Hero (تیتر اصلی)" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": [ "%", "px", "em", "rem", "vh", "vw" ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--carbon-base)",
      "text": "var(--wp--preset--color--titanium-white)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--vazirmatn)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.75"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--cad-steel)" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--signal-amber)",
          "text": "var(--wp--preset--color--carbon-base)"
        },
        "border": {
          "radius": "4px"
        },
        "typography": {
          "fontWeight": "700"
        }
      }
    }
  }
}
